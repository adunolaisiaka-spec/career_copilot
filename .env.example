# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database (configured in Phase 2) ---
DATABASE_URL=

# --- Test database (configured in Phase 13) ---
# Use a separate Neon branch (or any Postgres instance) you don't mind wiping —
# integration tests write and delete real rows against this URL.
TEST_DATABASE_URL=

# --- Auth.js (configured in Phase 3) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- AI provider (configured in Phase 5+) ---
# AI_PROVIDER selects which adapter lib/ai/ uses at runtime.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- File storage (configured in Phase 5 / production hardening) ---
STORAGE_PROVIDER=local
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- External job board API (configured in Phase 7, optional) ---
JOB_API_KEY=
