# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database (configured in Phase 2) ---
DATABASE_URL=

# --- Test database (configured in Phase 13) ---
# Use a separate Neon branch (or any Postgres instance) you don't mind wiping —
# integration tests write and delete real rows against this URL.
TEST_DATABASE_URL=

# --- Auth.js (configured in Phase 3) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- AI provider (configured in Phase 5+) ---
# AI_PROVIDER selects which adapter lib/ai/ uses at runtime.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- File storage ---
# Leave STORAGE_PROVIDER unset to auto-detect: uses Vercel Blob if a store is
# linked to the Vercel project (either BLOB_READ_WRITE_TOKEN, the classic
# static token, or BLOB_STORE_ID via the newer OIDC-based connection — both
# set automatically when you connect a Blob store, no manual copy-paste
# needed), otherwise falls back to local disk (dev only — local disk does not
# work on Vercel's deployed functions).
# STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=

# --- External job board API (configured in Phase 7, optional) ---
JOB_API_KEY=

# --- Email ---
# Leave RESEND_API_KEY unset to auto-detect: falls back to a console.log stub
# (dev only — verification/reset links print to the terminal instead of
# sending). Get a key at https://resend.com/api-keys. EMAIL_FROM defaults to
# Resend's unverified-domain test sender, which only delivers to the
# account's own registered email — verify a domain in the Resend dashboard
# and set EMAIL_FROM to an address on it to send to real users.
RESEND_API_KEY=
# EMAIL_FROM=Career Copilot <onboarding@resend.dev>

# --- Cron (scheduled interview reminders, see vercel.json) ---
# Optional locally (the route allows unauthenticated requests when unset).
# On Vercel, set this and Vercel automatically sends it as a Bearer token on
# cron-triggered requests — see https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=

# --- Payments (Stripe) ---
# Test-mode keys from https://dashboard.stripe.com/test/apikeys. Free plan
# usage limits still work with these unset — the "Upgrade to Pro" button just
# errors until they're configured.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_PRO_PRICE_ID: create with e.g. `stripe prices create --product ... --unit-amount 900
# --currency usd -d "recurring[interval]=month"`, or via the Stripe dashboard (Products).
STRIPE_PRO_PRICE_ID=
# STRIPE_WEBHOOK_SECRET: from the webhook endpoint's settings page in the
# Stripe dashboard (Developers → Webhooks → your endpoint) once one exists
# pointing at https://<your-deployed-url>/api/webhooks/stripe, listening for
# checkout.session.completed, customer.subscription.updated, and
# customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=
